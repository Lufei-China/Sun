<?xml version="1.0" encoding="UTF-8"?>
<!-- Don't forget to set system property
-Dlog4j2.contextSelector=org.apache.logging.log4j.core.async.AsyncLoggerContextSelector
     to make all loggers asynchronous. -->
<configuration status="WARN">
    <Properties>
        <Property name="service">sun</Property>
        <Property name="brokers">10.114.5.128:9092,10.114.5.129:9092,10.114.5.130:9092</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %T %t %-5level %logger{36} - %msg%n"/>
        </Console>
        <RollingFile name="RollingFile" fileName="./logs/sun.log"
                     filePattern="./logs/sun-%d{yyyy-MM-dd}-%i.log">
            <!--控制台只输出level及以上级别的信息（onMatch），其他的直接拒绝（onMismatch）-->
            <ThresholdFilter level="info" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="1000 MB"/>
            </Policies>
        </RollingFile>
    </Appenders>
    <loggers>
        <root level="info">
            <appender-ref ref="Console"/>
        </root>
        <Logger name="com.inmobi.supply.sun" level="debug"/>
        <Logger name="org.apache.kafka" level="ERROR"/>
        <Logger name="com.framework.starter" level="DEBUG"/>

    </loggers>
</configuration>