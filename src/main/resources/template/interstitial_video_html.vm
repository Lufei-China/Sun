var experienceManager = function (podList) {
    var isPod = $isPod;
    var isRewarded = "$rewarded";
    var adExperience = "$experience"; //getting experience from .vm file
    var skipDelayTimeForRewarded = 5000; //TODO parameterize skipdelay
    var isFirstAd = false;
    var hasNextAd = false;
    var sdkAdPodOrientation = "";
    var isSdkAdPodResponse = $isSdkPod;
    var userAgent = navigator.userAgent;
    var deviceOS = userAgent.match(/iPhone|iPad|iPod/i) ? "ios" : (userAgent.match(/Android/i) ? "android" : "");

    var globalPodManager = new window.podsInitializr(isSdkAdPodResponse, deviceOS, setOrientation); //initialize new podManger

    (function experienceType() { //stores experience Type at global level
        var expType = parseInt(adExperience, 10);
        const expSet = new Set([0, 1, 2]);
        if (!expSet.has(expType)) {
            expType = 1;
        } // attaching experience to window as it can be read from common place for decorator
        window.experienceType = expType;
    })();

    globalPodManager.initiatePods(podList); //initiating the pods

    var adListener = window.adListener(isPod, globalPodManager, isRewarded, skipDelayTimeForRewarded, isSdkAdPodResponse, hasNextAd);

    var checkForMraid = function () {
        adListener.hideAllPods(); //hide all pods before starting the first pod
        if (typeof (mraid) !== "undefined") {
            if (mraid.getState() === "loading") {
                mraid.addEventListener("ready", onMraidReady);
            } else {
                onMraidReady();
            }
        } else {
            onViewable();
        }
    };

    function setOrientation() {
        var orientation = getAdOrientation();
        mraidSetOrientation(orientation)
    }

    function mraidSetOrientation(orientation) {
        if (orientation === "portrait") {
            mraid.setOrientationProperties({allowOrientationChange: false, forceOrientation: "portrait"});
        } else {
            mraid.setOrientationProperties({allowOrientationChange: false, forceOrientation: "landscape"});
        }
    }

    function getAdOrientation() {
        var firstValidPod = adListener.getFirstValidPod();
        var currentDecorator = globalPodManager.pods[firstValidPod];
        var adDimensions = currentDecorator.getAdOrientattion();
        var orientation = adDimensions.orientationForPod;
        return orientation;
    }

    function fireOnViewableBecon() {
        var validPod = adListener.getFirstValidPod();
        var currentDecorator = globalPodManager.pods[validPod];
        currentDecorator.fireOnViewableBecon();
    }

    function checkHasNextAd() { //check if we have next ad based on currentad and renderable indexes
        var currentAdIndex = adListener.getCurrentRenderingIndex();
        var renderableAdIndexes = adListener.getRenderableAdIndexes();
        var indexOfAdInRenderableAds = renderableAdIndexes.indexOf(currentAdIndex);
        var renderableAdsLength = renderableAdIndexes.length;
        if (indexOfAdInRenderableAds < renderableAdsLength - 1) {
            return true;
        }
        return false;
    }

    function imraidSetAdContext(adContext) {
        adContext = JSON.stringify(adContext);
        imraid.setAdContext(adContext);
    }

    function imraidGetAdContext() {
        var context = JSON.parse(imraid.getAdContext());
        return context;
    }

    function checkIsFirstSdkAdPod() {
        var adIndex = adListener.getCurrentRenderingIndex();
        var arenderableAdIndex = adListener.getRenderableAdIndexes();
        if (arenderableAdIndex.indexOf(adIndex) == "0") {
            return true;
        }
        return false;
    }

    function updateExperienceType(experience) { //update experience on global level so that it can be accessed everywhere across decorator and podmanager
        window.experienceType = parseInt(experience, 10);
    }

    function setSdkAdPodContext() { //we are setting necessary addetails context which can be used across ad pods
        if (isSdkAdPodResponse) {
            hasNextAd = checkHasNextAd(); //check if we have next ad
            isFirstAd = checkIsFirstSdkAdPod();
            var videoDuration = adListener.getPodDurationTime(globalPodManager.currentAd);
            var skipDelayForNextAd;
            if (isFirstAd) { //for firstSdkadPod setorientation, experienceType is already set by default when Sdkadpod is initialized
                if (deviceOS === "android") {
                    var adOrientation = getAdOrientation();
                    sdkAdPodOrientation = adOrientation;
                } //setting context for 2nd and subsequent ads, since hasNextAd will change accordingly
                if (isRewarded === "true") {
                    //handle skip delay for non rewarded
                    //update skip delay when we have first video and second ad interstitial, when skip delay is greater than first video
                    //handling skipRewarded delay for rewarded
                    var skipDelayRewarded = skipDelayTimeForRewarded / 1000;
                    if (skipDelayRewarded > videoDuration) { //passing skip delay difference to next ad
                        skipDelayForNextAd = skipDelayRewarded - videoDuration;
                    } else {
                        skipDelayForNextAd = 0
                    }
                }
            } else if (hasNextAd) { //for 2nd ad in SdkadPods get experience and orientation from context and set for current context
                var adContext = imraidGetAdContext();
                if (deviceOS === "android") {
                    sdkAdPodOrientation = adContext.orientation;
                }
                updateExperienceType(adContext.experience);
                if (isRewarded === "false") {
                    removeSkipDelay() // need to show skip skipall from ad start for second and third ad
                } else { // for rewarded get skip delay from context and set to current ad
                    skipDelayTimeForRewarded = adContext.skipDelay * 1000; // pass remaning skip delay to next ad if skip delay is more than current runnning ad
                    var skipDelayRewarded = skipDelayTimeForRewarded / 1000
                    if (skipDelayRewarded > videoDuration) { //passing skip delay difference to next ad
                        skipDelayForNextAd = skipDelayRewarded - videoDuration;
                    } else {
                        skipDelayForNextAd = 0;
                    }
                }
            } else { // handling 3rd ad in ad pod
                var adContext = imraidGetAdContext();
                if (deviceOS === "android") {
                    sdkAdPodOrientation = adContext.orientation;
                }
                updateExperienceType(adContext.experience);
                if (isRewarded === "false") {
                    removeSkipDelay() // need to show skip skipall from ad start for second and third ad
                } else { // for rewarded get skip delay from context and set to current ad
                    skipDelayTimeForRewarded = adContext.skipDelay * 1000;
                }
            }
            var adContext = {
                orientation: sdkAdPodOrientation,
                experience: window.experienceType,
                skipDelay: skipDelayForNextAd
            }
            imraidSetAdContext(adContext);
        }
    }

    function removeSkipDelay() { // setting skipdelay as 0 globally for second and third ad
        videoSkipDelayInMs = 0
    }

    function setSdkAdOrientation() { // for video4.1 and video pods orientation is set at the time of fireadready
        if (isSdkAdPodResponse) { // wrt sdkadpods only for android we will be setting orientation here, for IOS we have to set orientation before fireready. refer fireready comments for further explanation
            if (isFirstAd) {//for AdResponseFlow
                //setOrientation only for first ad
                //need to set experience as well only for first ad in adPod
                setOrientation();
            } else { //for 2nd and 3rd ad set orientation from 1st ad
                mraidSetOrientation(sdkAdPodOrientation);
            }
        }
    }

    var onViewable = function () {
        setSdkAdPodContext();
        setSdkAdOrientation();
        adListener.addAdClickHandler();
        viewableChangeHandlerForPlayAndResume();
        fireOnViewableBecon();
        adListener.showFirstAd();
    };

    function viewableChangeHandlerForPlayAndResume() { // need to removelistener and add again to retain context with individual pods
        mraid.removeEventListener("viewableChange", arguments.callee);
        mraid.addEventListener("viewableChange", function (viewable) { //pause and resume video only in current pod
            var currentPod = globalPodManager.currentAd;
            var currentDecorator = globalPodManager.pods[currentPod];
            currentDecorator.viewableChangeForResumeAndPlay(viewable);
        });
    }

    var disableSdkClose = function () {
        mraid.useCustomClose(true);
        /* disableCloseRegion works on SDK >= 450 */
        if (imraid && typeof (imraid.disableCloseRegion) === "function") {
            imraid.disableCloseRegion(true);
        }
    };

    var onMraidReady = function () {
        /* disable SDK close hotspot */
        disableSdkClose();
        /* add imraid error listener */
        imraid.addEventListener("error", function (message) {
            var firstValidPod = adListener.getFirstValidPod(); //we can fire from any pod, picking the first valid pod to fire becon
            globalPodManager.pods[firstValidPod].fireCustomBecon("imraid-error")
        });
        /* add ad click handler */
        /* Wait for the ad to become visible for the first time */
        if (typeof (mraid.isViewable) === "function" && mraid.isViewable()) {
            onViewable();
        } else {
            mraid.addEventListener("viewableChange", function (viewable) {
                if (viewable) {
                    mraid.removeEventListener("viewableChange", arguments.callee);
                    onViewable();
                }
            });
        }
        /* disable back button */
        if (imraid && typeof (imraid.disableBackButton) === "function") {
            imraid.disableBackButton(true);
        }
        /* hide status bar */
        if (deviceOS === "ios" && imraid && typeof (imraid.hideStatusBar) === "function") {
            imraid.hideStatusBar();
        }
    };
    // starting function
    checkForMraid();
}
