ntent{flex-direction:column;display:flex;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;background-color:${hash}fff;border-radius:10px;margin:auto;border:1px solid ${hash}888;width:294px;height:182px;-webkit-border-radius:10px;-moz-border-radius:10px;-ms-border-radius:10px;-o-border-radius:10px}.modal-body p{margin:39px auto 20px;width:88%;text-align:center;color:${hash}333;font-size:14px}.clearfix{width:100%}.btn{width:240px;height:40px;outline:0;border-radius:10px;-webkit-border-radius:10px;-moz-border-radius:10px;-ms-border-radius:10px;-o-border-radius:10px;margin:0 auto;font-size:14px;border:0}${hash}continueBtn{background:${hash}DE4345;color:${hash}fff}${hash}skipBtn{background-color:${hash}fff;color:${hash}999;margin-top:8px}</style></head><body><div id="ad-cont" class="ad_hidden"><div id="ad_pg"><div id="commonElements"><div id="skip-close"><div class="block-4 iconsToHide hide" id="skip-btn"><img class="icons" data-action="skipVideo" src="https://prod-supply-bucket.oss-cn-beijing.aliyuncs.com/sdk/sdk/skip.svg"></div><div class="block-5 iconsToHide" id="ecCloseBtn"><img class="icons" id="ecCloseBtnIcon" data-action="closeAd" src="https://prod-supply-bucket.oss-cn-beijing.aliyuncs.com/sdk/sdk/close.svg"></div><div class="block-6 iconsToHide hide" id="skipAll"><img class="icons" data-action="skipAllAd" src="https://prod-supply-bucket.oss-cn-beijing.aliyuncs.com/sdk/sdk/skipAllBtn.svg"></div><div id="timerWrapper" class="timerWrapper hide"><div id="timerCount" class="timerCount">00s后可领取奖励</div></div></div></div>#set($podCount=0) #set($pod= "_pod") #foreach($creative in $creativeList) #set($podName = "$podCount$pod")<div id="${creative.ns}adPage" class="pod-ad"><div id="${creative.ns}ad_pg1" class="ad_pg1"><div id="${creative.ns}video_div" class="block-1 hide"><inmobi-video class="ad_video" id="${creative.ns}ad_video" not-ready="" autoplay="" muted="" hidetimer="true" show-controls="timer, volume" iconsvisible=""></inmobi-video><div class="vol-overlay" data-action="videoCta" style="display:none"></div></div><div id="${creative.ns}ad_vpaid" class="hide"><video id="${creative.ns}ad_vpaidvideo" data-action="vpaidVideoClick" style="width: 100%;height: 100%" webkit-playsinline="" playsinline=""></video></div><div id="${creative.ns}video_cta" class="block-2 hide" data-action="videoCta"><img class="inmobiLogo" src="https://prod-supply-bucket.oss-cn-beijing.aliyuncs.com/sdk/sdk/push.png" alt=""><div class="videoCard-cta-btn" id="${creative.ns}videoCardCtaBtn"><img id="endCardLogo" class="endCard-logo" src="${model.iconUrl}"><div class="videotext"><p class="videoTitle">${model.title}</p><p class="videodesc">${model.description}</p></div><p class="cta-btn" data-action="endCardCta">${modeText}</p></div></div></div><div id="${creative.ns}ad_pg2" class="hide ad_pg2"><div id="${creative.ns}endCardImage" class="endCardImage" data-action="endCardImage" style="pointer-events:none;height: calc(100vh - 364px)"></div><div id="${creative.ns}endCardBackground" class="endCardBackground hide" data-action="endCardBackground"></div><div class="endCard-cta-btn hide" id="${creative.ns}endCardCtaBtn"><img id="endCardLogo" class="endCard-logo" src="${model.iconUrl}"><p class="endCard-boxTitle">${model.title}</p><p class="endCard-boxDesc">${model.description}</p><p class="endCard-boxbtn" data-action="endCardCta">${modeText}</p></div></div></div>#set($podCount=$podCount+1) #end</div><div id="skipVideoModal" class="modal"><div class="modal-content"><div class="modal-body"><p>${htmlContext.popUpText}</p></div><div class="modal-footer"><div class="clearfix"><button type="button" id="continueBtn" class="btn">${htmlContext.continueText}</button> <button type="button" id="skipBtn" class="btn">${htmlContext.skipText}</button></div></div></div></div><div id="act_click" class="hide"></div><script>var decorator = function (vast, adOrientation, pod_ns, beconSuffix, isPod, skan, demandBundleId, skoverlay) {
    var utilFunc = function (pod_ns) {

        var recordEventFun = window[pod_ns+"recordEvent"];
        var disableFireReadyFunc = window[pod_ns+"disableAutoFireAdReady"];
        var fireAdReadyFuc = window[pod_ns+"fireAdReady"];
        var fireAdFailedFunc = window[pod_ns+"fireAdFailed"];
        const CLIENT_FILL = 120;
        var clientFillFired = false;

        var userAgent = navigator.userAgent;
        var deviceOS = userAgent.match(/iPhone|iPad|iPod/i) ? "ios" : (userAgent.match(/Android/i) ? "android" : "");

        var getTime = function () {
            return new Date().getTime();
        };

        var sendBeacon = function (id, extraParams) {
            var params = {};

            for (var key in extraParams) {
                if (extraParams.hasOwnProperty(key)) {
                    params[key] = extraParams[key];
                }
            }
            if (recordEventFun && typeof (recordEventFun) === "function") {
                recordEventFun(id, params);
            }
            //console.log("send beacon\t" + id + "\tparams:\t" + JSON.stringify(extraParams) + "\ttimestamp:\t" + Math.floor(Date.now() / 1000))
        };

        /* fires ad failed function */
        var fireAdFailed = function () {
            if (mraid.getState() !== "loading") {
                if (typeof (fireAdFailedFunc) !== "undefined") {
                    fireAdFailedFunc();
                    sendBeacon(99, {"action": "ad-failed"});
                }
            } else {
                mraid.addEventListener("ready", fireAdFailed);
            }
        };

        var byId = function (id) {
            return document.getElementById(id);
        };

        mraid.addEventListener("error", function (message, action) {
            sendBeacon(99, {
                "action": "mraid-error",
                "label": message
            });
        });

        var getTimeDelaySince = function (startTime) {
                    /* Return the time delay in secs from a specified timeStamp */
                    var currentTime = (getTime() - startTime) / 1000;
                    return Math.round(currentTime);
                },
                bySelector = function (queryParam) {
                    return document.querySelector(queryParam);
                },
                setVisibleState = function (element, visible) {
                    element.style.display = visible ? "block" : "none";
                },
                addClass = function (element, className) {
                    element.classList.add(className);
                },
                removeClass = function (element, className) {
                    element.classList.remove(className);
                },
                addEventListener = function (element, eventName, handler) {
                    var startX = 0;
                    var startY = 0;
                    if (eventName === "tap") {
                        var touchMoved, touchStarted = false;
                        element.addEventListener("touchstart", function (e) {
                            e.stopPropagation();
                            startX = e.changedTouches[0].pageX;
                            startY = e.changedTouches[0].pageY;
                            touchStarted = true;
                            touchMoved = false;
                        });
                        element.addEventListener("touchmove", function (e) {
                            e.stopPropagation();
                            touchMoved = true;
                        });
                        element.addEventListener("touchend", function (e) {
                            e.stopPropagation();
                            var endY = e.changedTouches[0].pageY;
                            var endX = e.changedTouches[0].pageX;

                            var xDelta = Math.abs(endX - startX);
                            var yDelta = Math.abs(endY - startY);

                            if (touchStarted) {
                                touchStarted = false;
                                if (!touchMoved) {
                                    handler.call(null, e);
                                } else {
                                    if (xDelta <= 10 && yDelta <= 10) {
                                        handler.call(null, e);
                                    }
                                }
                            }
                        });
                    } else {
                        element.addEventListener(eventName, handler);
                    }
                };

        var callFireAdReady = function () {
            // console.log("called callFireAdReady");
            var sdkVersion = parseInt("$ad.sdkVersion".substr(1), 10) || 0;
            if (mraid.getState() !== "loading") {
                if (typeof (fireAdReadyFuc) === "function") {
                    fireAdReadyFuc();
                }
            } else {
                /* wait for ready event */
                mraid.addEventListener("ready", callFireAdReady);
            }
            if(!clientFillFired) {
                sendBeacon(CLIENT_FILL);
                clientFillFired = true;
            }
        };

        var getDeviceOS = function () {
            return deviceOS;
        };

        var generateRandomNo = function(){
            var number = Math.floor((Math.random() * 100) + 1);
            return number
        }

        var checkExperimentRange = function (range, randomNo) { //this function checks experiement range and return true if random no falls in that range
            var minimumValue = range.minimum;
            var maximumValue = range.maximum;
            return minimumValue <= randomNo && randomNo <= maximumValue
        };

        var fireBeacon = function (url) {
            var img = new Image();
            img.src = url;
        };

        var fireBeacons = function (trackingUrls) {
            trackingUrls = trackingUrls || [];
            trackingUrls.forEach(function (url) {
                fireBeacon(url);
            });
        };

        var sendErrorBeacon = function (errorTrackingUrls, errorCode) {
            var errorCodeMacro = "ERRORCODE";
            var errorUrl= [];
            if(errorTrackingUrls){
                for (var i = 0; i < errorTrackingUrls.length; i++) {
                    errorUrl.push(errorTrackingUrls[i].replace(errorCodeMacro, errorCode));
                }
            }
            fireBeacons(errorUrl);
            /* send error beacons to InMobi also */
            sendBeacon(99, {
                "action": "vast-error",
                "label": errorCode
            });
            // console.log("vast error beacon fired:" + errorCode)
        };


        return {
            fireAdFailed: fireAdFailed,
            sendBeacon: sendBeacon,
            byId: byId,
            getTime: getTime,
            addEventListener: addEventListener,
            bySelector: bySelector,
            setVisibleState: setVisibleState,
            addClass: addClass,
            removeClass: removeClass,
            getTimeDelaySince: getTimeDelaySince,
            callFireAdReady: callFireAdReady,
            getDeviceOS: getDeviceOS,
            generateRandomNo: generateRandomNo,
            checkExperimentRange: checkExperimentRange,
            disableFireReadyFunc: disableFireReadyFunc,
            fireBeacons: fireBeacons,
            sendErrorBeacon: sendErrorBeacon
        };
    };
    window["utilFunc"] = utilFunc;


    var utils = window.utilFunc(pod_ns);
    var eventTrackers = function(pod_ns, beconSuffix, utils, isPod, vpaidHelper, eventFlags) {
        var RENDER = 18,
                CTA = 8,
                MEDIA_AUTO_PLAY = 10,
                MEDIA_QUARTILE = 12,
                MEDIA_END = 13,
                MEDIA_PAUSE = 14,
                MEDIA_ERROR = 16,
                MEDIA_UNPAUSE = 17,
                CUSTOM = 99,
                videoFinishBeaconPercent = "90%"
        ;

        var eventNames = {
            InitAd: "initAd",
            StartAd: "startAd",
            StopAd: "stopAd"
        };
        var impressionTrackersFired = false, errorBeaconFired = false, videoCTAFired = false, endCardCTAFired = false, videoCTADelayOver = false;

        var _imraid = imraid,
                getTime = utils.getTime,
                getTimeDelaySince = utils.getTimeDelaySince,
                sendBeacon = utils.sendBeacon,
                sendErrorBeacon = utils.sendErrorBeacon,
                fireBeacons = utils.fireBeacons
        ;

        var fireVideoPlayTrackers = function (videoData, renderTime, isVpaid, impressionTrackers, trackingUrls) {
            if (!videoData.playStarted) {
                videoData.playStarted = true;
                var mediaStartTime = getTime();
                var renderToPlayTime = mediaStartTime - renderTime;
                var customAction = isVpaid ? "render-to-play_v" : "render-to-play";
                var label = Math.round(renderToPlayTime / 1000);
                if (label >= 10) {
                    label = 10;
                }
                sendBeacon(CUSTOM, {"action": customAction + beconSuffix, "label": label});
                if (!impressionTrackersFired) {
                    fireBeacons(trackingUrls["start"]);
                    sendBeacon(MEDIA_AUTO_PLAY);
                    sendBeacon(RENDER);
                    fireBeacons(impressionTrackers);
                    impressionTrackersFired = true;
                }
            } else if (!videoData.mediaPlaying && !videoData.videoCompleted) {
                /* video resume event */
                fireBeacons(trackingUrls["resume"]);
                // id=17 beacons is not consumed, can cleanup
                sendBeacon(MEDIA_UNPAUSE, {
                    secs: getTimeDelaySince(mediaStartTime)
                });
            }
            videoData.mediaPlaying = true;
        };

        var fireAdFailedFunc = function (error) {
            // console.log("fireAdFailedFunc-------", pod_ns);
            var label = "";
            if (error !== undefined && error !== null) {
                label = error;
            }
            sendBeacon(CUSTOM, {
                "action": "parsing-failed" + beconSuffix, "label": label
            });
            var event = new CustomEvent("adFailed", {"detail": pod_ns});

            // trigger event to suffix saying ad has failed
            document.dispatchEvent(event);
        };

        var fireVideoClickTrackers = function (trackingUrls) {
            if (!videoCTAFired) {
                videoCTAFired = true;
                sendBeacon(CTA);
                fireBeacons(trackingUrls["clickTracking"]);
            }
        };

        var callFireAdReadyFunc = function () {
            // if(isPod){
            //     sendBeacon(CUSTOM, {
            //         "action": "ad-ready"+ beconSuffix,
            //     });
            // }
            var event = new CustomEvent("adReady", {"detail": pod_ns});
            // trigger event to suffix saying ad is ready
            document.dispatchEvent(event);
            // utils.callFireAdReady();
        };

        var fireCompanionClickTrackers = function (companionTrackers, trackingUrls) {
            if (!endCardCTAFired) {
                endCardCTAFired = true;
                if (companionTrackers !== undefined && companionTrackers["companionClick"] !== undefined) {
                    fireBeacons(companionTrackers["companionClick"]);
                    sendBeacon(CTA);
                } else if (!videoCTAFired) {
                    videoCTAFired = true;
                    fireBeacons(trackingUrls["clickTracking"]);
                    sendBeacon(CTA);
                }
            }
        };

        window["fireInmCompanionClickTrackers"] = fireCompanionClickTrackers;

        var fireVideoPauseTrackers = function (videoData, trackingUrls) {
            if (videoData.playStarted && !videoData.videoCompleted) {
                videoData.mediaPlaying = false;
                // id=14 beacons is not consumed, can cleanup
                sendBeacon(MEDIA_PAUSE);
                fireBeacons(trackingUrls["pause"]);
            }
        };

        var fireFirstQuartileTrackers = function (trackingUrls) {
            // if(isPod){
            //     sendBeacon(CUSTOM, {"action": "first-quartile"+beconSuffix});
            // }
            fireBeacons(trackingUrls["firstQuartile"]);
            sendBeacon(MEDIA_QUARTILE, {"q": 1});
        };

        var fireSecondQuartileTrackers = function (trackingUrls) {
            fireBeacons(trackingUrls["midpoint"]);
            sendBeacon(MEDIA_QUARTILE, {"q": 2});
        };

        var fireThirdQuartileTrackers = function (trackingUrls) {
            fireBeacons(trackingUrls["thirdQuartile"]);
            sendBeacon(MEDIA_QUARTILE, {"q": 3});
        };

        var fireVideoCompleteTrackers = function (trackingUrls) {
            fireBeacons(trackingUrls["complete"]);
            sendBeacon(MEDIA_END, {});
        };

        var fireVideoMuteTrackers = function (trackingUrls) {
            fireBeacons(trackingUrls["mute"]);
        };

        var fireVideoUnMuteTrackers = function (trackingUrls) {
            fireBeacons(trackingUrls["unmute"]);
        };

        var fireIncentiveBecon = function (podData, isRewarded, incentiveJson) {
            if (podData.playStarted && isRewarded === "true") {
                console.log("fire incentive becon-----------")
                try {
                    _imraid.incentCompleted(JSON.parse(incentiveJson));
                } catch (e) {
                    sendBeacon(CUSTOM, {"action": "incentiveJson", "label": "jsonParseError"});
                }

            }
        };

        var fireOnViewableBecon = function (isVpaid) {
            var isPod = beconSuffix === "" ? "" : "-pod";
            var action = "";
            if (isVpaid) {
                action = "on-viewable_v"
            } else {
                action = "on-viewable"
            }
            sendBeacon(CUSTOM, {
                "action": action + isPod
            });
        };

        var onVideoComplete = function (videoData) {
            // console.log("onVideoComplete------");
            videoData.videoCompleted = true;
            var adContainer = document.getElementById("ad-cont");
            var evt = new CustomEvent('podVideoEnded', {detail: pod_ns});
            // console.log("endedevt-------",evt);
            //firing event to notify suffix that video has ended and if not to show next ad
            // if(isPod){
            //     sendBeacon(CUSTOM, {"action": "video-complete"+beconSuffix});
            // }
            adContainer.dispatchEvent(evt);
        };

        var videoCtaVisibilityOn = function (videoDuration, videoSkipDelayInMs, videoLandingUrl) {
            var ctaDelay = Math.min((videoDuration * 1000 / 4), videoSkipDelayInMs, 3 * 1000);
            setTimeout(function () { //video cta button visibility delay
                // Disabling video CTA button for video experience 0,2(Basic, High CTR)
                if (videoLandingUrl !== "" && window.experienceType === 1) {
                    var ctaBtnInVideo = document.getElementById(pod_ns + "video_cta");
                    ctaBtnInVideo.classList.remove("hide");
                }
                videoCTADelayOver = true;
            }, ctaDelay);
        };

        var videoCallback = function (event, videoData, renderTime, isVpaid, impressionTrackers, trackingUrls, videoLandingUrl, videoDuration, videoSkipDelayInMs, errorTrackingUrls) {
            var isAdViewable = false;
            if (typeof (_mraid) !== "undefined") {
                if (_mraid.isViewable()) {
                    isAdViewable = true;
                }
            } else {
                isAdViewable = true;
            }
            switch (event.type) {
                case "inmobi-video-play":
                    // if(isPod){
                    //     sendBeacon(CUSTOM, {"action": "video-start"+beconSuffix});
                    // }
                    // sendBeacon(CUSTOM, {action: "experience-"+ window.experienceType});
                    fireVideoPlayTrackers(videoData, renderTime, isVpaid, impressionTrackers, trackingUrls);
                    videoCtaVisibilityOn(videoDuration, videoSkipDelayInMs, videoLandingUrl);
                    break;
                case "inmobi-video-pause":
                    fireVideoPauseTrackers(videoData, trackingUrls);
                    break;
                case "inmobi-video-ended":
                    onVideoComplete(videoData);
                    break;
                case "inmobi-video-error":
                    // id=16 beacons is not consumed, can cleanup
                    // console.log("inside inmobi-video-error---------")
                    sendBeacon(MEDIA_ERROR, {errorType: event.detail.errorCode});
                    if (!errorBeaconFired) {
                        errorBeaconFired = true;
                        sendBeacon(CUSTOM, {"action": "media-error-" + beconSuffix + event.detail.errorCode});
                        // console.log("inside inmobi-video-error before firing---------")
                        sendErrorBeacon(errorTrackingUrls, event.detail.errorCode);
                        fireAdFailedFunc("media-error-" + event.detail.errorCode);
                    }
                    break;
                case "inmobi-video-stop":
                    sendBeacon(CUSTOM, {
                        action: "video-aborted" + beconSuffix
                    });
                    break;
                case "inmobi-video-quartile":
                    if (impressionTrackersFired && isAdViewable) {
                        if (event.detail.quartile === "q3") {
                            fireThirdQuartileTrackers(trackingUrls);
                        } else if (event.detail.quartile === "q2") {
                            fireSecondQuartileTrackers(trackingUrls)
                        } else if (event.detail.quartile === "q1") {
                            fireFirstQuartileTrackers(trackingUrls);
                        } else if (event.detail.quartile === videoFinishBeaconPercent) {
                            fireVideoCompleteTrackers(trackingUrls);
                        }
                    }
                    break;
                case "inmobi-video-can-play":
                    // sendBeacon(CUSTOM, {"action": "inmobi-video-can-play"});
                    break;
                case "inmobi-video-showIcons": //show icons
                    if (videoCTADelayOver && window.experienceType === 2) { // 2 is for HIGH_CTR, in HIGH_CTR whole video is clickable.
                        console.log('inmobi-video-showIcons')
                        fireVideoClickTrackers(trackingUrls);
                        window.openLandingPage(videoLandingUrl);
                    }
                    break;
                case "inmobi-video-mute":
                    fireVideoMuteTrackers(trackingUrls);
                    break;
                case "inmobi-video-unmute":
                    fireVideoUnMuteTrackers(trackingUrls);
                    break;
            }
        };

        var adStarted = function (videoData, renderTime, isVpaid, impressionTrackers, trackingUrls) {
            // console.log("inside adStarted fun");
            eventFlags.AdStarted = true;
            sendBeacon(CUSTOM, {"action": "VPAID" + beconSuffix, "label": "adStarted"});
            if (isPod) {
                sendBeacon(CUSTOM, {"action": "video-start" + beconSuffix});
            }
            fireVideoPlayTrackers(videoData, renderTime, isVpaid, impressionTrackers, trackingUrls);
        };

        var AdLoaded = function () {
            // console.log("inside adLoaded");
            callFireAdReadyFunc();
            eventFlags.AdLoaded = true;
            sendBeacon(CUSTOM, {"action": "VPAID" + beconSuffix, "label": "AdLoaded"});
            utils.setVisibleState(utils.byId("ad-cont"), true);
            utils.setVisibleState(utils.byId(pod_ns + "video_div"), false);
            utils.setVisibleState(utils.byId(pod_ns + "ad_vpaid"), true);
            // console.log("done adLoaded");
        };

        var vpaidCallback = function (vpaidAd, videoData, errorTrackingUrls, adParameters, setVideoLandingUrl, trackingUrls, containerWidth, containerHeight, AdError, renderTime, isVpaid, impressionTrackers, timeout) {
            console.log("vpaidCallback trigger...");
            sendBeacon(CUSTOM, {"action": "VPAID" + beconSuffix, "label": "finishedJSLoad"});
            var AdStarted = function(){
                adStarted(videoData, renderTime, isVpaid, impressionTrackers, trackingUrls)
            }
            // window["vpaidAd"] = vpaidAd;
            if (vpaidAd == null) {
                sendBeacon(CUSTOM, {"action": "NO_VPAID" + beconSuffix});
                sendErrorBeacon(errorTrackingUrls, 901);
                fireAdFailedFunc("NO_VPAID");
            } else {
                if (vpaidHelper.supportedVersion("2.0", vpaidAd.handshakeVersion("1.0"))) {
                    // console.log("vpaid handshake completed" + "\tvpaidAd.handshakeVersion()" + vpaidAd.handshakeVersion());
                    var creativeData = {};
                    creativeData['AdParameters'] = adParameters;
                    // console.log("creativeData" + JSON.stringify(creativeData));
                    // console.log("Loading VPAID listeners");
                    // vpaidAd.subscribe(AdLoaded, 'AdLoaded');

                    vpaidAd.subscribe(AdLoaded, 'AdLoaded');

                    vpaidAd.subscribe(function (event) {
                        // console.log("got AdImpression event" + JSON.stringify(event));
                    }, 'AdImpression');

                    vpaidAd.subscribe(AdStarted, 'AdVideoStart');

                    vpaidAd.subscribe(function (event) {
                        fireFirstQuartileTrackers(trackingUrls);
                        // sendBeacon(CUSTOM, {"action": "VPAID", "label": "AdVideoFirstQuartile"});
                    }, 'AdVideoFirstQuartile');

                    vpaidAd.subscribe(function (event) {
                        fireSecondQuartileTrackers(trackingUrls);
                        // sendBeacon(CUSTOM, {"action": "VPAID", "label": "AdVideoMidpoint"});
                    }, 'AdVideoMidpoint');

                    vpaidAd.subscribe(function (event) {
                        fireThirdQuartileTrackers(trackingUrls);
                        // sendBeacon(CUSTOM, {"action": "VPAID", "label": "AdVideoThirdQuartile"});
                    }, 'AdVideoThirdQuartile');

                    vpaidAd.subscribe(function () {
                        fireVideoCompleteTrackers(trackingUrls);
                        // moveToEndCard();
                        onVideoComplete(videoData);
                        sendBeacon(CUSTOM, {"action": "VPAID" + beconSuffix, "label": "AdVideoComplete"});
                    }, 'AdVideoComplete');

                    vpaidAd.subscribe(function (url, id, playerHandles) {
                        // console.log("got AdClickThru");
                        var videoLandingUrl;
                        fireVideoClickTrackers(trackingUrls);
                        if (url !== undefined && playerHandles && (typeof url === 'string' || url instanceof String)) {
                            videoLandingUrl = url;
                            setVideoLandingUrl(url)
                        } else {
                            var event = url;
                            if (event !== undefined && event.data !== undefined && event.data.playerHandles !== undefined && event.data.playerHandles) {
                                if (event.data.url !== undefined && event.data.url !== "") {
                                    videoLandingUrl = event.data.url;
                                    setVideoLandingUrl(event.data.url)
                                }
                            }
                        }
                        console.log("videoLandingUrl",openLandingPage);
                        window.openLandingPage(videoLandingUrl);
                    }, 'AdClickThru');

                    vpaidAd.subscribe(function () {
                        if (!eventFlags.AdStopped) {
                            sendBeacon(CUSTOM, {"action": "VPAID_AdStopped" + beconSuffix});
                            // console.log("ad stopped");
                            //dispatching podend event when video stops which is controlled by vpaid
                            // console.log("before fring event");
                            // console.log("!adStopped--------",!adStopped)
                            if (!adStopped) {
                                // console.log("firing ad------------")
                                var adContainer = document.getElementById("ad-cont");
                                var evt = new CustomEvent('podVideoEnded', {detail: pod_ns});
                                // if(isPod){
                                //     sendBeacon(CUSTOM, {"action": "video-complete"+beconSuffix});
                                // }
                                adContainer.dispatchEvent(evt);
                            }
                            // moveToEndCard();
                            eventFlags.AdStopped = true;
                        }
                    }, 'AdStopped');

                    vpaidAd.subscribe(AdError, 'AdError');

                    var environmentVars = {};
                    environmentVars.slot = utils.byId(pod_ns + 'ad_vpaid');
                    environmentVars.videoSlot = utils.byId(pod_ns + 'ad_vpaidvideo');
                    environmentVars.videoSlot.poster = "https://prod-supply-bucket.oss-cn-beijing.aliyuncs.com/sdk/sdk/poster.gif";
                    environmentVars.videoSlot.style.height = "100%";
                    environmentVars.videoSlot.style.width = "100%";
                    environmentVars.videoSlot.style.position = "center";
                    environmentVars.videoSlotCanAutoPlay = true;
                    environmentVars.videoSlot.hidden = false;

                    vpaidAd.initAd(containerWidth, containerHeight, "fullscreen", 8192, creativeData, environmentVars);
                    timeout(eventNames.InitAd, 5000);
                } else {
                    sendBeacon(CUSTOM, {"action": "VPAID_unsupported_version" + beconSuffix});
                    sendErrorBeacon(errorTrackingUrls, 901);
                    fireAdFailedFunc("VPAID_unsupported_version");
                }
            }
        };

        return { // public interface
            videoCallback: videoCallback,
            vpaidCallback: vpaidCallback,
            fireVideoPlayTrackers: fireVideoPlayTrackers,
            fireVideoClickTrackers: fireVideoClickTrackers,
            fireCompanionClickTrackers: fireCompanionClickTrackers,
            callFireAdReadyFunc: callFireAdReadyFunc,
            fireAdFailedFunc: fireAdFailedFunc,
            fireVideoPauseTrackers: fireVideoPauseTrackers,
            onVideoComplete: onVideoComplete,
            videoCtaVisibilityOn: videoCtaVisibilityOn,
            fireIncentiveBecon: fireIncentiveBecon,
            fireOnViewableBecon: fireOnViewableBecon
        };
    };
    window["eventTrackers"] = eventTrackers;
    var pod = function (utils, isPod, pod_ns, timeout, eventNames, beconSuffix, skan, demandBundleId, podData, skoverlay) {

