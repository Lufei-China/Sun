        console.log("fireVideoClickTrackers:", fireVideoClickTrackers);
        console.log("videoLandingUrl:", videoLandingUrl);
        console.log("companionLandingUrl:", companionLandingUrl);

        var handleVolumeButton = function () {
            if (window.experienceType === 1) { //except for experience 1 for remaining experienceType(high CTR experience) show volume and timer icons always
                videoElement.iconsvisible = false;
            }
