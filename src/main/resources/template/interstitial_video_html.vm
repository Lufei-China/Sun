        skipModal.style.display = 'none';
    }


    return {
        addAdClickHandler: addAdClickHandler,
        showFirstAd: showFirstAd,
        getRenderableAdIndexes: getRenderableAdIndexes,
        getCurrentRenderingIndex: getCurrentRenderingIndex,
        hideAllPods: hideAllPods,
