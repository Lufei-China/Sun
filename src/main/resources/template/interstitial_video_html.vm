                /* ERROR 302: Wrapper limit as defined by player reached */
                errorCode = 302;
            }
            if (unwrappingSuccess) {
                successCallback(vastBlob);
            } else {
                sendErrorBeacon(errorTrackingUrls, errorCode);
                errorCallback(errorCode);
            }
