window["endCard"] = endCard;</script><script>var podsInitializr = function (isSdkAdPodResponse, deviceOS, setOrientation) {
    this.pods = {}; //stores all instance of decorator where all function are available wrt each decorator
    this.currentAd = ""; //stores id of currentPod, id is nothing but namespaced id
    var that = this;
    this.allPods = []; //stores array of object with id and status eg: [{id:100,status:undefined}], status is to check if ad is ready to show without any error after parsing or anywhere else while parsing
    var isPod = $isPod;
    var podManagerReady = false; //to handle firead ready which chouls not be fired multiple times
    var beaconSuffix = "";


    this.initiatePods = function (podList) {
        for (var i = 0; i < podList.length; i++) {
            var ns = podList[i].ns;
            if (isPod) {//add becon suffix only for pod else send becon as empty ""
                beaconSuffix = "_" + i;
            }
            that.allPods.push({
                id: ns,
                status: undefined
            });
            var experienceConfig = {orientation: podList[i].orientation, isPod: isPod};
            var experienceRequest = {
                vast: podList[i].vast,
                demandBundleId: podList[i].demandBundleId,
                ns: ns,
                skan: podList[i].skan,
                beaconSuffix: beaconSuffix,
                skoverlay: podList[i].skoverlay
            };
            var expeienceObject = window.experienceFactory();
            that.pods[ns] = expeienceObject(experienceRequest, experienceConfig);
        }
    };

    //adding eventListeners for adready and adfailed
    var readyFailureEvents = ["adReady", "adFailed"]
    for (var i = 0; i < readyFailureEvents.length; i++) {
        document.addEventListener(readyFailureEvents[i], callBackForReadyFailureEvents);
    }

    function callBackForReadyFailureEvents(event) {
        var podId = event.detail;
        switch (event.type) {
            case "adReady":
                changeValueInAllPods(podId, true);
                document.dispatchEvent(new CustomEvent("validDecorator", {"detail": podId}));
                break;
            case "adFailed":
                changeValueInAllPods(podId, false);
                document.dispatchEvent(new CustomEvent("inValidDecorator", {"detail": podId}));
                break;
        }
        ;
    };

    function changeValueInAllPods(id, status) {
        //update the status true or false of pod in allpods array
        var getAllPods = that.allPods;
        for (var i in getAllPods) {
            if (getAllPods[i].id == id) {
                getAllPods[i].status = status;
                break;
            }
        }
    }

    this.fireSuccess = function () {
        // this function has logic for fireadready
        var fireSuccessReady = true;
        var getAllPods = that.allPods;
        var thatPods = that.pods;
        var validIndex = 0;
        for (var i in getAllPods) {
            if (getAllPods[i].status === undefined) {
                fireSuccessReady = false
                break;
            } else {
                if (getAllPods[i].status === true) {
                    validIndex = i;
                    break;
                }
                ;
            }
            ;
        }
        ;
        if (fireSuccessReady) {
            if (podManagerReady === false) {
                podManagerReady = true;
                that.currentAd = that.allPods[validIndex].id;
                // var timeDiff = Math.round(((new Date().getTime()) - initTime)/1000);
                // var firsPodId = this.allPods[0].id;
                // var firstDecorator = this.pods[firsPodId];
                // var isItpod = "";
                // if(isPod){
                //     isItpod = "-pod"
                // }
                // firstDecorator.fireCustomBecon("duration-init-fireReady"+isItpod, timeDiff)
                thatPods[that.allPods[validIndex].id].loadSkStore(); //need to load sk store for
                if (!isSdkAdPodResponse || deviceOS === "ios") {
                    // IOS doesnt support setting orientation midway, need to set before calling fireAdready, once orientation set , its retained across sdkAdpoda and cannot be changed
                    // Android doesnt support retaining orientation across ads for ad pods,
                    // Setting orientation fo ios, pod and video4.1
                    // Handling updating of orientation in setSdkadPodContext for android
                    setOrientation(); //set orientation of landscape or portrait before calling first ad;
                }
                thatPods[that.allPods[validIndex].id].fireReady();
            }
        }
    };

    this.fireFailure = function () {
        //logic to fire adfailed, here we are firing ad ready here even if one ad has status true
        var allPods = that.allPods;
        var allAdsFailure = true; //variable to check if all ads failed
        var validStartIndex;
        var thatPods = that.pods;
        var fireAdFailedEvent = true;
        for (var i = 0; i < allPods.length; i++) {
            if (allPods[i].status === true || allPods[i].status === false) {
                if (allPods[i].status === true && validStartIndex !== undefined) {
                    validStartIndex = i;
                    fireAdFailedEvent = false;
                    break;
                }
            } else {
                fireAdFailedEvent = false;
                break;
            }
        }
        if (!fireAdFailedEvent) {
            if (validStartIndex !== undefined) {
                if (podManagerReady === false) {
                    podManagerReady = true;
                    that.currentAd = that.allPods[validStartIndex].id;
                    if (!isSdkAdPodResponse || deviceOS === "ios") {
                        // IOS doesnt support setting orientation midway, need to set before calling fireAdready, once orientation set , its retained across adpoda and cannot be changed
                        // Android doesnt support retaining orientation across ads for ad pods,
                        // Setting orientation fo ios, pod and video4.1
                        // Handling updating of orientation in setSdkadPodContext for android
                        setOrientation(); //set orientation of landscape or portrait before calling first ad;
                    }
                    thatPods[that.allPods[validStartIndex].id].loadSkStore(); //need to load sk store for
                    thatPods[that.allPods[validStartIndex].id].fireReady();
                }
            }
        } else {
            for (var i = 0; i < allPods.length; i++) {
                if (allPods[i].status !== false) {
                    allAdsFailure = false;
                }
            }
            if (allAdsFailure === true) {
                // fire ad failed only when all ads in creative list has failed
                thatPods[that.allPods[0].id].fireFailed();
            }
        }
    }

    var decoratorEvents = ["validDecorator", "inValidDecorator"]
    for (var i = 0; i < decoratorEvents.length; i++) {
        document.addEventListener(decoratorEvents[i], callBackForDecoratorEvents);
    }

    function callBackForDecoratorEvents(event) {
        // call bask function to fireSuccess, added timeout here of 0 seconds to have ignorable delay. without time out event gets fired by listener not able to capture event
        var podId = event.detail;
        switch (event.type) {
            case "validDecorator":
                setTimeout(function () {
                    that.fireSuccess(podId);
                }, 0);
                break;
            case "inValidDecorator":
                setTimeout(function () {
                    that.fireFailure(podId);
                }, 0);
                break;
        }
    }
};

